# mobile/.env.example
# Copier vers mobile/.env (ne JAMAIS committer le .env réel — voir .gitignore)
# Chargé via flutter_dotenv, ou passé en --dart-define-from-file=.env selon le choix d'équipe.

# URL et clé publique du projet Supabase correspondant à l'environnement ciblé.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# development | staging | production
ENVIRONMENT=development

# Optionnel — suivi des crashs/erreurs (Sentry ou équivalent)
SENTRY_DSN=

# ------------------------------------------------------------------
# NE JAMAIS AJOUTER ICI :
#   - SUPABASE_SERVICE_ROLE_KEY (donne un accès total, contourne RLS)
#   - toute clé secrète backend
# Ces valeurs n'ont pas leur place dans une application mobile.
# ------------------------------------------------------------------
