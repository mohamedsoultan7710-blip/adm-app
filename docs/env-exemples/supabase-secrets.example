# Secrets de projet Supabase — NE VONT PAS dans un fichier .env du dépôt.
# À définir via le dashboard Supabase (Project Settings > Edge Functions > Secrets)
# ou en CLI : supabase secrets set NOM=valeur
#
# Ce fichier documente uniquement les clés attendues par les Edge Functions
# décrites dans PROJECT_PLAN.md (§2.1, supabase/functions/).

# Compte de service Firebase (JSON), utilisé par l'Edge Function send-push
# pour envoyer des notifications push via Firebase Cloud Messaging (Android + iOS).
FCM_SERVICE_ACCOUNT_JSON=

# Si envoi d'emails transactionnels (vérification de compte, etc.)
RESEND_API_KEY=

# Jeton partagé vérifié par les Edge Functions déclenchées par une tâche
# planifiée (pg_cron / Supabase Scheduled Triggers), pour empêcher un appel
# HTTP direct non autorisé de l'endpoint (ex: expiration-reminders).
CRON_SECRET=
