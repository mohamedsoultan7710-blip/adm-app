# dashboard/.env.local.example
# Copier vers dashboard/.env.local (ne JAMAIS committer le .env.local réel)

# Exposées au navigateur (préfixe NEXT_PUBLIC_ requis par Next.js) — clé anon uniquement.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ------------------------------------------------------------------
# SERVEUR UNIQUEMENT — jamais préfixée NEXT_PUBLIC_, jamais envoyée au
# navigateur. Utilisée seulement dans les Route Handlers / Server Actions
# pour des opérations privilégiées explicitement protégées côté serveur.
# ------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
